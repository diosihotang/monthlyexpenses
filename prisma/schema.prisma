datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Status {
  SUCCESS
  PENDING
}

// Pemilik ruang data. Login cukup username + PIN 4 digit;
// username baru otomatis dibuat saat pertama kali dipakai.
model User {
  id             String        @id @default(cuid())
  username       String        @unique
  pinHash        String
  // Proteksi brute force PIN: dikunci sementara setelah beberapa kali salah
  failedAttempts Int           @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
  sessions       Session[]
}

// Perangkat yang sudah login. Cookie hanya menyimpan token acak;
// database menyimpan hash-nya, jadi bocornya isi tabel tidak membuat sesi bisa dipakai.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model Transaction {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(12, 2)
  category    String
  type        TransactionType
  description String?
  date        DateTime        @default(now())
  status      Status          @default(SUCCESS)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([type])
  @@index([userId, date])
}